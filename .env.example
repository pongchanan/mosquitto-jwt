MOSQUITTO_TCP_HOST="your-tcp-host.example.com"
MOSQUITTO_TCP_PORT=1883
MOSQUITTO_WS_HOST="your-ws-host.example.com"
MOSQUITTO_WS_PORT=9001

MOSQUITTO_USER="admin"
JWT_SECRET="your-jwt-secret-key"

# Note: For Railway deployments, you can find these values in:
# - MOSQUITTO_TCP_HOST: Railway variable MOSQUITTO_TCP_HOST
# - MOSQUITTO_TCP_PORT: Railway variable MOSQUITTO_TCP_PORT
# - MOSQUITTO_WS_HOST: Railway variable MOSQUITTO_WS_HOST
# - MOSQUITTO_WS_PORT: Railway variable MOSQUITTO_WS_PORT (usually 443 for Railway)
# - MOSQUITTO_USER: Railway variable MOSQUITTO_USER
# - JWT_SECRET: Railway variable JWT_SECRET
